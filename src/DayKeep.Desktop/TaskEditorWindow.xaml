<Window x:Class="DayKeep.TaskEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="日守 · 任务" Width="628" Height="790" MinHeight="560" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="{StaticResource Ink}"
 UseLayoutRounding="True" KeyDown="OnKeyDown" Loaded="OnLoaded">
 <Window.Resources>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="11,9" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#CBDACF" /><Setter Property="BorderThickness" Value="1" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#347568" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,11,0,6" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
 </Window.Resources>
 <Border Margin="15" CornerRadius="20" Background="#FAF7F9F3" BorderBrush="#BACCC5" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.15" Color="#243B3A" /></Border.Effect>
  <Grid Margin="25,16,25,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8" MouseLeftButtonDown="DragHeader"><TextBlock x:Name="Heading" Text="记下一件重要的事。" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="×" Click="CancelClick" Style="{StaticResource ChromeButton}" HorizontalAlignment="Right" FontSize="22" AutomationProperties.Name="关闭任务表单" /></DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,8">
     <TextBlock Text="先保存下来，后续每天接着跟进。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,3" />
     <TextBlock Text="任务名称 *" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TitleInput" MaxLength="120" AutomationProperties.Name="任务名称" />
     <TextBlock Text="任务类型" Style="{StaticResource FieldLabel}" />
     <ComboBox x:Name="KindInput" SelectedIndex="1" Padding="9,8" FontSize="13" AutomationProperties.Name="任务类型"><ComboBoxItem Content="普通待办 · 直接办理直到完成" /><ComboBoxItem Content="等待条件 · 先查看何时可以办理" /></ComboBox>
     <TextBlock Text="平台链接（可选）" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UrlInput" MaxLength="2048" AutomationProperties.Name="平台链接" />
     <Border Background="#E8EFE4" CornerRadius="10" Padding="13,11" Margin="0,18,0,0"><TextBlock Text="提醒使用电脑本地时间；请保持日守运行。今天已过去的时间不会立即补弹。" TextWrapping="Wrap" FontSize="11" Foreground="#56704F" /></Border>
     <TextBlock Text="提醒时间 *" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TimesInput" Text="09:00" MaxLength="100" AutomationProperties.Name="提醒时间" />
     <TextBlock Text="24 小时格式；多个时间用逗号分开，例如 09:00, 14:30。" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" />
     <TextBlock Text="提醒星期 *" Style="{StaticResource FieldLabel}" />
     <WrapPanel x:Name="WeekdayPanel"><CheckBox Content="一" Tag="1" IsChecked="True" Margin="0,0,15,4" /><CheckBox Content="二" Tag="2" IsChecked="True" Margin="0,0,15,4" /><CheckBox Content="三" Tag="4" IsChecked="True" Margin="0,0,15,4" /><CheckBox Content="四" Tag="8" IsChecked="True" Margin="0,0,15,4" /><CheckBox Content="五" Tag="16" IsChecked="True" Margin="0,0,15,4" /><CheckBox Content="六" Tag="32" IsChecked="True" Margin="0,0,15,4" /><CheckBox Content="日" Tag="64" IsChecked="True" Margin="0,0,0,4" /></WrapPanel>
     <TextBlock Text="截止日期（未知时留空）" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DueInput" MaxLength="10" AutomationProperties.Name="截止日期" /><TextBlock Text="格式 yyyy-MM-dd，例如 2026-12-01；允许记录已逾期的事项。" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" />
     <TextBlock Text="备注" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NotesInput" Height="64" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="任务备注" />
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="ErrorLabel" Foreground="#A14839" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" Visibility="Collapsed" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="保存任务" Style="{StaticResource PrimaryButton}" Click="SaveClick" IsDefault="True" /><Button Grid.Column="2" Content="取消" Click="CancelClick" /></Grid></StackPanel>
  </Grid>
 </Border>
</Window>
